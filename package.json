{
  "name": "routelog-tray",
  "version": "1.0.0",
  "description": "RouteLog — Tray app para notificações em tempo real",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "start": "electron . --no-sandbox",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "auto-launch": "^5.0.6"
  },
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/node": "^20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.routelog.tray",
    "productName": "RouteLog",
    "files": ["dist/**/*", "assets/**/*"],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
